# Orbit deployment configuration.
#
# This file is copied once into your persistent deployment directory by
# scripts/configure.sh and preserved there on every recognised upgrade.
# Edit the copy in your deployment directory, not this example, and never
# commit it or paste secret values into a shared command or terminal history.
#
# A direct secret (for example SESSION_SECRET) and its matching "_FILE" form
# (SESSION_SECRET_FILE) are mutually exclusive: configure only one of each
# pair. Values marked "installer-managed" below are generated and written by
# scripts/configure.sh; do not hand-regenerate them.
#
# Every supported variable stays available here, active or as a commented
# example. README.md and the operator documentation explain the workflows.

ORBIT_CONFIG_SCHEMA_VERSION=1

# --- Required: public URL and authentication --------------------------------
APP_URL=https://orbit.example.com
# Loopback development only; never use plain HTTP for a real deployment:
# APP_URL=http://127.0.0.1:3000
OIDC_ISSUER=https://auth.example.com/application/o/orbit/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# File-backed form, set only by `scripts/configure.sh --set-oidc-secret`
# (never hand-edit the path or the referenced file):
# OIDC_CLIENT_SECRET_FILE=/run/orbit-secrets/orbit-oidc-client-secret
OIDC_CALLBACK_URL=https://orbit.example.com/api/auth/callback
# Loopback development only; never use plain HTTP for a real deployment:
# OIDC_CALLBACK_URL=http://127.0.0.1:3000/api/auth/callback

# --- Installer-managed: image and generated values ---------------------------
ORBIT_IMAGE=
# Installer-managed Compose project identity; do not edit after installation.
# COMPOSE_PROJECT_NAME=orbit
# Installer-managed provenance for the exact image that last validated this
# configuration; the installer writes these values and operators must not edit them.
# ORBIT_CONFIG_APPLIED_VERSION=v1.2.0
# ORBIT_CONFIG_APPLIED_DIGEST=sha256:<64 lowercase hexadecimal characters>
SESSION_SECRET_FILE=.orbit-secrets/session-secret
# SESSION_SECRET=<64-character-random-hex>
DOCUMENT_KEK_FILE=.orbit-secrets/document-kek
# DOCUMENT_KEK=<64-character-random-hex>
POSTGRES_PASSWORD_FILE=.orbit-secrets/postgres-password
# POSTGRES_PASSWORD=<generated-random-password>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_FILE=
# VAPID_PRIVATE_KEY=<base64url-private-key>

# --- Ordinary deployment exposure --------------------------------------------
ORBIT_BIND_ADDRESS=0.0.0.0
ORBIT_PORT=3000
# Operational log verbosity: error, warn, info or debug. Records are bounded
# and redacted; document content, filenames and recipients are never logged.
ORBIT_LOG_LEVEL=info
# Optional collector format: text (default) or json. Both use the same fields.
ORBIT_LOG_FORMAT=text
# Optional services, selected by configuration rather than by a different
# compose command. Leave empty for the standard deployment. Add "processing"
# for the local document parser, "ai" for the private model server, or both:
# COMPOSE_PROFILES=processing,ai
COMPOSE_PROFILES=
POSTGRES_DB=orbit
POSTGRES_USER=orbit
# Compose overrides POSTGRES_HOST to the database service name inside
# containers; these defaults apply only to local, non-Docker development.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# Alternative to the POSTGRES_* settings above; leave both DATABASE_URL forms
# empty when using them.
# DATABASE_URL=postgres://orbit:example-password@postgres:5432/orbit
# DATABASE_URL_FILE=/run/secrets/orbit-database-url

# --- Optional: document processing -------------------------------------------
# Malware scanning, storage limits and retention already have safe defaults;
# override only with a documented reason.
# DOCUMENTS_ROOT=/var/lib/orbit/documents
# DOCUMENTS_QUARANTINE_ROOT=/tmp/orbit-document-quarantine
# DOCUMENT_MAX_BYTES=26214400
# DOCUMENT_HOUSEHOLD_QUOTA_BYTES=5368709120
# DOCUMENT_INSTANCE_QUOTA_BYTES=21474836480
# DOCUMENT_RETENTION_DAYS=30
# DOCUMENT_SCAN_RECOVERY_RETENTION_HOURS=24
# DOCUMENT_SCAN_MODE=required
# CLAMAV_HOST=orbit-clamav
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=30000
# CLAMAV_MEMORY_LIMIT=4g
# Local document parser/OCR and private model server. Both stay off unless
# also selected in COMPOSE_PROFILES above. TIKA_URL is a private
# Compose-network address, never internet-facing.
# TIKA_URL=http://orbit-tika:9998
# TIKA_TIMEOUT_MS=45000
# TIKA_MEMORY_LIMIT=1g
# OLLAMA_MODEL=<a-local-model-name>
# OLLAMA_MEMORY_LIMIT=6g
# OLLAMA_CPUS=2.0
# OLLAMA_MAX_QUEUE=8
# OLLAMA_KEEP_ALIVE=0

# --- Optional: outbound and inbound mail --------------------------------------
# Mail stays fully disabled until every required value below is set. Inbound
# IMAP is explicitly disabled until an operator changes this value only after
# completing the entire SMTP, mailbox and verified-alias boundary.
IMAP_ENABLED=false
# STARTTLS is required by default; use implicit_tls only for a provider that
# requires TLS from connection start (465).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=orbit@example.com
# SMTP_PASSWORD=
# SMTP_PASSWORD_FILE=/run/orbit-secrets/orbit-smtp-password
# SMTP_FROM=Orbit <orbit@example.com>
# Deprecated compatibility form; do not set alongside the individual SMTP
# settings above.
# SMTP_URL=
# SMTP_URL_FILE=
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=orbit@example.com
# IMAP_PASSWORD=
# IMAP_PASSWORD_FILE=/run/orbit-secrets/orbit-imap-password
# IMAP_MAILBOX=INBOX
# IMAP_TLS_SERVER_NAME=
# IMAP_RECIPIENT_DOMAIN=orbit.example.com
# IMAP_TRUSTED_RECIPIENT_HEADER=X-Original-To
# IMAP_POLL_SECONDS=300
# Current aliases are HMAC-derived from this positive generation and secret.
# IMAP_ALIAS_CURRENT_GENERATION=1
# IMAP_ALIAS_CURRENT_SECRET=
# IMAP_ALIAS_CURRENT_SECRET_FILE=/run/orbit-secrets/orbit-imap-alias-current-secret
# Optional bounded transition. Configure all three values together; omit all
# three to invalidate the previous generation immediately.
# IMAP_ALIAS_PREVIOUS_GENERATION=
# IMAP_ALIAS_PREVIOUS_SECRET=
# IMAP_ALIAS_PREVIOUS_SECRET_FILE=
# IMAP_ALIAS_PREVIOUS_EXPIRES_AT=

# --- Optional: push notifications ---------------------------------------------
# VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY_FILE above are generated
# automatically; set only the contact address below to enable push.
# VAPID_SUBJECT=mailto:admin@example.com

# --- Advanced: limits and tuning -----------------------------------------------
# SESSION_TTL_SECONDS=604800
# OIDC_SCOPES=openid profile email
# OIDC_EMAIL_CLAIM=email
# OIDC_EMAIL_VERIFIED_CLAIM=email_verified
# OIDC_NAME_CLAIM=name
# OIDC_AVATAR_CLAIM=picture
# WORKER_POLL_SECONDS=60
# NOTIFICATION_MAX_ATTEMPTS=5
# Local, non-Docker startup only; the Compose stack always applies
# migrations and runs the worker regardless of these settings.
# MIGRATE_ON_START=false
# WORKER_ENABLED=false
# DRIZZLE_MIGRATIONS_PATH=drizzle
# ORBIT_SECRETS_DIR=./.orbit-secrets
