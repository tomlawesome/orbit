{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-with-orbit-env.mjs node_modules/next/dist/bin/next dev",
    "build": "node scripts/run-with-orbit-env.mjs node_modules/next/dist/bin/next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node scripts/run-with-orbit-env.mjs .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "node scripts/run-with-orbit-env.mjs node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node scripts/run-with-orbit-env.mjs node_modules/tsx/dist/cli.mjs src/db/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "imapflow": "1.5.0",
    "jose": "^6.0.0",
    "next": "^16.0.0",
    "nodemailer": "^7.0.0",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
