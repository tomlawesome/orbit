{
  "name": "orbit",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./server/*": "./src/server/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./db": "./src/db/index.ts",
    "./db/schema": "./src/db/schema.ts"
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "preinstall": "node scripts/guard-worktree-install.mjs",
    "lint": "eslint . --concurrency auto",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/test-integration.mjs",
    "test:web-pdfjs": "node scripts/web-pdfjs-runtime-check.mjs",
    "acceptance:mailbox": "node scripts/acceptance-mailbox.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "orbit": "node_modules/tsx/dist/cli.mjs src/cli/orbit.ts",
    "build:cli": "node scripts/bundle-orbit-cli.mjs",
    "db:generate": "node scripts/db-generate-refused.mjs",
    "db:migrate": "node scripts/run-with-orbit-env.mjs node_modules/tsx/dist/cli.mjs src/db/migrate.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.8",
    "@napi-rs/canvas-linux-x64-gnu": "1.0.8",
    "@napi-rs/canvas-linux-x64-musl": "1.0.8",
    "drizzle-orm": "^0.45.2",
    "imapflow": "1.7.8",
    "jose": "^6.0.0",
    "nodemailer": "^9.0.3",
    "pdfjs-dist": "6.3.289",
    "postgres": "^3.4.7",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "^0.31.0",
    "esbuild": "0.28.2",
    "eslint": "^10.0.0",
    "eslint-plugin-svelte": "3.23.0",
    "happy-dom": "^20.11.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
