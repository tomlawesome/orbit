{
  "name": "orbit",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./server/*": "./src/server/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./db": "./src/db/index.ts",
    "./db/schema": "./src/db/schema.ts"
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "preinstall": "node scripts/guard-worktree-install.mjs",
    "lint": "eslint . --concurrency auto",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/test-integration.mjs",
    "test:web-pdfjs": "node scripts/web-pdfjs-runtime-check.mjs",
    "acceptance:mailbox": "node scripts/acceptance-mailbox.mjs",
    "bundle:extract": "node scripts/extract-bundle/build.mjs",
    "eval:extraction": "node_modules/tsx/dist/cli.mjs src/server/documents/model-eval-cli.ts",
    "eval:sieve": "node_modules/tsx/dist/cli.mjs src/server/documents/sieve-recall-cli.ts",
    "eval:tags": "node_modules/tsx/dist/cli.mjs src/server/documents/tag-accuracy-cli.ts",
    "eval:date-sieves": "node_modules/tsx/dist/cli.mjs src/server/documents/date-sieve-report-cli.ts",
    "eval:amount-sieves": "node_modules/tsx/dist/cli.mjs src/server/documents/amount-sieve-report-cli.ts",
    "eval:provider-sieves": "node_modules/tsx/dist/cli.mjs src/server/documents/provider-sieve-report-cli.ts",
    "eval:provider-bins": "node_modules/tsx/dist/cli.mjs src/server/documents/provider-bins-cli.ts",
    "eval:shortlist": "node_modules/tsx/dist/cli.mjs src/server/documents/shortlist-recall-cli.ts",
    "eval:stages": "node_modules/tsx/dist/cli.mjs src/server/documents/stages-score-cli.ts",
    "eval:subtype-runs": "node_modules/tsx/dist/cli.mjs src/server/documents/subtype-runs-cli.ts",
    "eval:provider-stage1": "node_modules/tsx/dist/cli.mjs src/server/documents/provider-stage1-cli.ts",
    "eval:provider-stage2": "node_modules/tsx/dist/cli.mjs src/server/documents/provider-stage2-cli.ts",
    "eval:provider-pick": "node_modules/tsx/dist/cli.mjs src/server/documents/provider-pick-cli.ts",
    "eval:provider-caps": "node_modules/tsx/dist/cli.mjs src/server/documents/provider-caps-cli.ts",
    "eval:holdout": "node_modules/tsx/dist/cli.mjs src/server/documents/holdout-score-cli.ts",
    "eval:breakdown": "node_modules/tsx/dist/cli.mjs src/server/documents/holdout-breakdown-cli.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "orbit": "node_modules/tsx/dist/cli.mjs src/cli/orbit.ts",
    "build:cli": "node scripts/bundle-orbit-cli.mjs",
    "db:generate": "node scripts/db-generate-refused.mjs",
    "db:migrate": "node scripts/run-with-orbit-env.mjs node_modules/tsx/dist/cli.mjs src/db/migrate.ts",
    "rewrap-kek": "node scripts/run-with-orbit-env.mjs node_modules/tsx/dist/cli.mjs src/db/rewrap-kek.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.9",
    "@napi-rs/canvas-linux-x64-gnu": "1.0.9",
    "@napi-rs/canvas-linux-x64-musl": "1.0.9",
    "@node-rs/argon2": "2.2.1",
    "@node-rs/argon2-linux-x64-gnu": "2.2.1",
    "@node-rs/argon2-linux-x64-musl": "2.2.1",
    "drizzle-orm": "^0.45.2",
    "imapflow": "2.0.2",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.9",
    "pdfjs-dist": "6.3.289",
    "postgres": "^3.4.7",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "5.0.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "0.28.2",
    "eslint": "^10.0.0",
    "eslint-plugin-svelte": "3.23.0",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.4.1"
}
