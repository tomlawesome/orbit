    },
    ".orbit-secrets/postgres-password": {
      "mode": 384,
      "content": "<64-hex-char-secret>\n"
    },
    ".orbit-secrets/session-secret": {
      "mode": 384,
      "content": "<64-hex-char-secret>\n"
    }
