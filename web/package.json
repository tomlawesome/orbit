{
  "name": "orbit-web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/collect-font-licences.mjs && vite build && node ../scripts/web-build-stamp.mjs write",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "scaffold": "node scripts/scaffold-screen.mjs",
    "fidelity": "playwright test --project=fidelity",
    "launch-timing": "playwright test --project=launch-timing",
    "preview:build": "vite build && rm -rf .preview && cp -r build .preview",
    "preview:serve": "PORT=4180 node .preview/index.js",
    "licences": "node scripts/collect-font-licences.mjs",
    "repro:782": "node tests/rolldown-repro/run.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.9",
    "@napi-rs/canvas-linux-x64-gnu": "1.0.9",
    "@napi-rs/canvas-linux-x64-musl": "1.0.9",
    "@node-rs/argon2": "2.2.1",
    "@node-rs/argon2-linux-x64-gnu": "2.2.1",
    "@node-rs/argon2-linux-x64-musl": "2.2.1",
    "drizzle-orm": "^0.45.2",
    "imapflow": "2.0.2",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.9",
    "pdfjs-dist": "6.3.289",
    "postgres": "^3.4.7",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "orbit": "workspace:*",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
