{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@": ["../src"],
      "@/*": ["../src/*"],
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "$lib/door/*": ["./types/door/*"],
      "$app/types": ["./.svelte-kit/types/index.d.ts"]
    }
  },
  "exclude": [
    "node_modules/**",
    "src/service-worker.js",
    "src/service-worker/**/*.js",
    "src/service-worker.ts",
    "src/service-worker/**/*.ts",
    "src/service-worker.d.ts",
    "src/service-worker/**/*.d.ts",
    "src/lib/door/**"
  ]
}
